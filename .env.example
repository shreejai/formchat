# OpenAI. Model names and prices are never hard-coded.
OPENAI_API_KEY=sk-dummy
OPENAI_MODEL_SMALL=small-model-name
OPENAI_MODEL_LARGE=large-model-name
OPENAI_MODEL_MODERATION=omni-moderation-latest
# Optional: lowest supported reasoning effort (e.g. minimal). Leave empty if the model has none.
OPENAI_REASONING_EFFORT=
# USD per 1M tokens. Reasoning tokens are billed at the output price.
OPENAI_PRICE_SMALL_IN=0.10
OPENAI_PRICE_SMALL_OUT=0.40
OPENAI_PRICE_LARGE_IN=1.00
OPENAI_PRICE_LARGE_OUT=4.00

# AI limits
AI_MAX_TOKENS_PER_CONVERSATION=6000
AI_TIMEOUT_MS=15000
DESCRIBE_RATE_LIMIT_PER_MIN=10
